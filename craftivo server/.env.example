# Copy to .env and fill values, then restart the server

# Environment
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/craftivo?schema=public

# JWT
JWT_SECRET=replace-with-32+chars-secret-min
JWT_EXPIRES_IN=1d

# AI (optional)
# GEMINI_API_KEY=your-gemini-api-key

# Invoices ingest automation (required for /api/v1/invoices/ingest-email)
# Long random string used by ApiKeyGuard to validate incoming requests
INVOICES_INGEST_API_KEY=Qv9mZp8wN3XG2kUJ6YfC1Rz7bD5HqM4Ta8LwE3Nv6PsR0UdJiKc2Xo9Vt1ByGhZd

# Numeric user id that will own created invoices via ingest
# Must correspond to an existing users.id in your database
INVOICES_INGEST_USER_ID=1
